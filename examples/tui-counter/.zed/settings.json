// Open this directory as its own Zed project (`zed examples/tui-counter`) to work on the
// terminal side: rust-analyzer runs for the host target here, so the `not(wasm32)` half
// of the workspace—skene-tui and this example—lights up. The repo root's settings point
// rust-analyzer at wasm32 instead; one rust-analyzer instance can only analyze for a
// single target, so the two views live in two projects.
{
  "wrap_guides": [100],
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" },
        "rustfmt": {
          "extraArgs": ["+nightly"],
        },
      },
    },
  },
}
