//! The app's terminal shell: `skene run terminal` runs it, `skene build terminal` builds it.

use {crate}_shared::Counter;
use skene_simple_terminal::prelude::*;
use skene_terminal::prelude::*;

#[main]
fn app() -> impl View {
  let counter = Counter::new();

  Theme::new(SimplePalette::default()).set_child_builder(move || {
    SimpleCard::new().set_children((
      Text::derive(move || counter.count().to_string()).set_color(SimplePalette::FOREGROUND),
      Row::new().set_spacing(2).set_children((
        SimpleButton::new("-").handle_activate(move || counter.decrement()),
        SimpleButton::new("+").handle_activate(move || counter.increment()),
      )),
    ))
  })
}
