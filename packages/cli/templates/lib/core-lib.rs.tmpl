//! The core of {name}, a skene component library: its palette, the sizes its views are
//! drawn at in each medium's unit, and its views, written once over the
//! [`Realization`]. A platform's crate exposes each view as a view of its own and reaches
//! its members through the view's `*Base` trait.

use skene_foundation::{
  AnyKind,
  Color,
  Container,
  CornerRadius,
  DecorationBase,
  DecorationWithCornerRadius,
  Definition,
  HasChild,
  Inset,
  Length,
  Media,
  NodeId,
  Realization,
  RunBase,
  Scalar,
  Text,
  ThemedIn,
  Token,
  TokenName,
  TokenRef,
  TokenSet,
  View,
  Wraps,
};

/// The library's colors: a token set a `Theme` defines beneath it, its default defined
/// at the root where no theme provides one.
#[derive(Debug, Clone, PartialEq)]
#[must_use]
pub struct {Type}Palette<N: Scalar> {
  /// A badge's surface.
  pub badge: Token<Color, N>,
  /// The ink on a badge.
  pub badge_ink: Token<Color, N>,
}

impl<N: Scalar> {Type}Palette<N> {
  /// A badge's surface.
  pub const BADGE: TokenRef<Color> = TokenRef::new("{name}-badge");
  /// The ink on a badge.
  pub const BADGE_INK: TokenRef<Color> = TokenRef::new("{name}-badge-ink");

  /// Sets a badge's surface.
  pub fn set_badge(mut self, badge: impl Into<Definition<Color, N>>) -> Self {
    self.badge = self.badge.redefine(badge);

    self
  }

  /// Sets the ink on a badge.
  pub fn set_badge_ink(mut self, badge_ink: impl Into<Definition<Color, N>>) -> Self {
    self.badge_ink = self.badge_ink.redefine(badge_ink);

    self
  }
}

impl<N: Scalar> Default for {Type}Palette<N> {
  /// Deep ink on a pale tint, and pale ink on a deep tint under the dark scheme.
  fn default() -> Self {
    let pale = Color::srgb(0.878, 0.906, 1.);
    let deep = Color::srgb(0.192, 0.180, 0.506);

    Self {
      badge: Token::new(
        Self::BADGE.name().as_str(),
        Definition::from(pale).when(Media::Dark, deep),
      ),
      badge_ink: Token::new(
        Self::BADGE_INK.name().as_str(),
        Definition::from(deep).when(Media::Dark, pale),
      ),
    }
  }
}

impl<N: Scalar, V: From<Definition<Color, N>>> TokenSet<V> for {Type}Palette<N> {
  fn definitions(&self) -> Vec<(TokenName, V)> {
    vec![self.badge.define(), self.badge_ink.define()]
  }
}

/// A length unit the {name} views know their sizes in.
#[diagnostic::on_unimplemented(
  message = "the {name} views have no sizes in `{Self}`",
  label = "a {name} view is drawn in logical pixels (`f32`) or cells (`u32`)"
)]
pub trait {Type}Unit: Scalar {
  /// The inset between a badge's edge and its label.
  const BADGE_INSET: Inset<Self>;
  /// The corner radius of a badge.
  const BADGE_RADIUS: Length;
}

impl {Type}Unit for f32 {
  const BADGE_INSET: Inset<Self> = Inset::symmetric(8., 2.);
  const BADGE_RADIUS: Length = Length(6.);
}

impl {Type}Unit for u32 {
  const BADGE_INSET: Inset<Self> = Inset::symmetric(1, 0);
  const BADGE_RADIUS: Length = Length(0.5);
}

/// A badge: a short label on a rounded, tinted surface.
#[doc(hidden)]
#[derive(Debug)]
#[must_use]
pub struct {Type}Badge<P: Realization> {
  label: Text<P>,
}

impl<P: Realization> {Type}Badge<P> {
  /// A badge reading `label`.
  pub fn new(label: impl Into<String>) -> Self {
    Self {
      label: Text::new(label),
    }
  }

  /// A badge reading what `label` returns, kept current with the signals it reads.
  pub fn derive(label: impl Fn() -> String + 'static) -> Self {
    Self {
      label: Text::derive(label),
    }
  }
}

impl<P: Realization> AnyKind for {Type}Badge<P> {}

impl<P: Realization> View<P> for {Type}Badge<P>
where
  P::Scalar: {Type}Unit,
  P::StyleExt: CornerRadius,
{
  fn build(self) -> NodeId {
    <{Type}Palette<P::Scalar> as ThemedIn<P>>::define_root();

    Container::new()
      .set_padding(<P::Scalar as {Type}Unit>::BADGE_INSET)
      .set_background({Type}Palette::<P::Scalar>::BADGE)
      .set_corner_radius(<P::Scalar as {Type}Unit>::BADGE_RADIUS)
      .set_child(
        self
          .label
          .set_color({Type}Palette::<P::Scalar>::BADGE_INK),
      )
      .build()
  }
}

/// What a platform's badge carries.
pub trait {Type}BadgeBase<P: Realization>: Wraps<Inner = {Type}Badge<P>> {
  /// A badge reading `label`.
  #[must_use]
  fn new(label: impl Into<String>) -> Self {
    Self::wrap({Type}Badge::new(label))
  }

  /// A badge reading what `label` returns, kept current with the signals it reads.
  #[must_use]
  fn derive(label: impl Fn() -> String + 'static) -> Self {
    Self::wrap({Type}Badge::derive(label))
  }
}
