{
  "moz:firefoxOptions": {
    "prefs": {
      "dom.webgpu.enabled": true,
      "gfx.webgpu.ignore-blocklist": true
    }
  },
  "goog:chromeOptions": {
    "args": [
      "--enable-unsafe-webgpu",
      "--enable-features=Vulkan",
      "--use-webgpu-adapter=swiftshader",
      "--enable-unsafe-swiftshader"
    ]
  }
}
